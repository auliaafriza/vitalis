EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the deployed web app lives.
#
# Load-bearing for sign-up: Supabase builds the confirmation link from this,
# via emailRedirectTo. Leave it unset and the app sends no redirect at all, so
# Supabase falls back to the project's Site URL — http://localhost:3000 in a
# fresh project, which is a dead link on a phone. Nothing errors; the only
# symptom is an email nobody can use.
#
# The built app gets this from eas.json instead; this file is for `expo start`.
EXPO_PUBLIC_SITE_URL=https://calorya-web.vercel.app
