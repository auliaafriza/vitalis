{
  "expo": {
    "name": "Vitalis",
    "slug": "vitalis",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vitalis",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitalis.app",
      "infoPlist": {
        "NSMotionUsageDescription": "Vitalis membaca data langkah dari perangkat untuk mengisi catatan aktivitas harianmu secara otomatis."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.vitalis.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#118A7A"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "edgeToEdgeEnabled": true,
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-sensors"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1c16c9e-2695-40dc-95ed-8a1bfad2f592"
      }
    },
    "owner": "auliaafriza"
  }
}
