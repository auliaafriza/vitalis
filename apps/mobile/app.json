{
  "expo": {
    "name": "Calorya",
    "slug": "calorya",
    "version": "0.2.1",
    "orientation": "portrait",
    "scheme": "calorya",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEFDFB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calorya.app",
      "infoPlist": {
        "NSMotionUsageDescription": "Calorya membaca data langkah dari perangkat untuk mengisi catatan aktivitas harianmu secara otomatis.",
        "NSCameraUsageDescription": "Calorya memakai kamera hanya untuk membaca barcode kemasan makanan. Tidak ada foto yang disimpan atau dikirim."
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.calorya.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEFDFB"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.CAMERA"
      ],
      "edgeToEdgeEnabled": true,
      "versionCode": 3
    },
    "plugins": [
      "expo-router",
      "expo-sensors",
      [
        "expo-camera",
        {
          "cameraPermission": "Calorya memakai kamera hanya untuk membaca barcode kemasan makanan. Tidak ada foto yang disimpan atau dikirim.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "auliaafriza",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4bbab60b-5c86-4a0d-af0c-7d94e1b3e839"
      }
    }
  }
}
